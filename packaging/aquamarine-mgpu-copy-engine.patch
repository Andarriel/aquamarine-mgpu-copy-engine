+
+void CVulkanCopier::log(eBackendLogLevel level, const std::string& msg) {
+    if (debug)
+        fprintf(stderr, "[aq-vk] %s\n", msg.c_str());
+    if (const auto B = backend.lock())
+        B->log(level, msg);
+}
+
+SP<CVulkanCopier> CVulkanCopier::attempt(SP<CBackend> backend_, int drmFD) {
+    if (envEnabled("AQ_MGPU_NO_VULKAN")) {
+        backend_->log(AQ_LOG_DEBUG, "vulkan: AQ_MGPU_NO_VULKAN set, not creating a copier");
+        return nullptr;
+    }
+
+    auto copier     = SP<CVulkanCopier>(new CVulkanCopier());
+    copier->backend = backend_;
+    copier->self    = copier;
+    copier->debug   = envEnabled("AQ_MGPU_VK_DEBUG");
+    copier->log(AQ_LOG_DEBUG, std::format("vulkan: creating copier for drm fd {}", drmFD));
+
+    if (!copier->init(drmFD)) {
+        backend_->log(AQ_LOG_DEBUG, "vulkan: copier init failed");
+        return nullptr;
+    }
+
+    backend_->log(AQ_LOG_DEBUG, std::format("vulkan: copier ready on {} (queue family {})", copier->deviceName, copier->queueFamily));
+    return copier;
+}
+
+CVulkanCopier::~CVulkanCopier() {
+    if (device) {
+        drainPending(2'000'000'000ull);
+        destroySlots();
+        if (commandPool)
+            fn.vkDestroyCommandPool(device, commandPool, nullptr);
+        fn.vkDestroyDevice(device, nullptr);
+    }
+    if (instance && fn.vkDestroyInstance)
+        fn.vkDestroyInstance(instance, nullptr);
+    if (loaderHandle)
+        dlclose(loaderHandle);
+}
+
+bool CVulkanCopier::healthy() const {
+    return device && !broken;
+}
+
+bool CVulkanCopier::loadLoader() {
+    loaderHandle = dlopen("libvulkan.so.1", RTLD_NOW | RTLD_LOCAL);
+    if (!loaderHandle) {
+        log(AQ_LOG_DEBUG, "vulkan: libvulkan.so.1 not found");
+        return false;
+    }
+
+    fn.vkGetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)dlsym(loaderHandle, "vkGetInstanceProcAddr");
+    if (!fn.vkGetInstanceProcAddr) {
+        log(AQ_LOG_ERROR, "vulkan: loader has no vkGetInstanceProcAddr");
+        return false;
+    }
+
+    fn.vkCreateInstance = (PFN_vkCreateInstance)fn.vkGetInstanceProcAddr(nullptr, "vkCreateInstance");
+    return !!fn.vkCreateInstance;
+}
