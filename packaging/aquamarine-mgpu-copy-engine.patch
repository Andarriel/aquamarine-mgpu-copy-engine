+#pragma once
+
+// Cross-GPU copy using the *primary* GPU's Vulkan device.
+//
+// In a multi-GPU setup the compositor renders on the primary GPU and the secondary GPU scans the
+// result out. The classic path imports the primary's buffer into the secondary's EGL and blits
+// there; when the secondary cannot import the primary's memory at all (e.g. Intel iGPU <-> NVIDIA
+// dGPU: i915 can't map VRAM and doesn't understand NVIDIA block-linear layouts) aquamarine falls
+// back to glReadPixels + glTexImage2D, which costs several ms of CPU per frame.
+//
+// This class goes the other way round: the primary GPU's Vulkan device imports the secondary's
+// (system memory, linear) scanout buffer and copies into it with its own copy engine. No CPU
+// touches the pixels. Synchronisation is explicit: the compositor's render fence is imported as a
+// wait semaphore and the copy signals a sync_file that the KMS commit waits on.
+
+#include <aquamarine/buffer/Buffer.hpp>
+#include <aquamarine/backend/Backend.hpp>
+#include <hyprutils/memory/SharedPtr.hpp>
+#include <hyprutils/memory/WeakPtr.hpp>
+#include <hyprutils/math/Region.hpp>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#ifdef AQUAMARINE_HAS_VULKAN
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+#endif
+
+namespace Aquamarine {
+    class CVulkanCopier;
+
+#ifdef AQUAMARINE_HAS_VULKAN
+    // Per-buffer cached VkImage import.
+    class CVulkanImageAttachment : public IAttachment {
+      public:
+        CVulkanImageAttachment(Hyprutils::Memory::CWeakPointer<CVulkanCopier> copier_, VkImage image_, VkDeviceMemory memory_, bool source_);
+        virtual ~CVulkanImageAttachment();
+
+        Hyprutils::Memory::CWeakPointer<CVulkanCopier> copier;
+        VkImage                                        image      = VK_NULL_HANDLE;
+        VkDeviceMemory                                 memory     = VK_NULL_HANDLE;
+        bool                                           source     = false;
+        bool                                           everCopied = false; // dst: first copy may transition from UNDEFINED
+
+        // Destinations only: the part of this image that is out of date with respect to the
+        // compositor's latest frame. A destination is written every few frames (the secondary
+        // swapchain rotates), so every frame's damage has to accumulate on all the others.
+        // Starts as the whole image: the first copy into a fresh buffer must be complete.
+        Hyprutils::Math::CRegion                       stale;
+
+        // the copy this image was last written by, so a new copy into it can be ordered after it.
+        // Vulkan gives no implicit ordering between separate submissions to the same queue.
+        size_t                                         lastSlot   = SIZE_MAX;
+        uint64_t                                       lastCopyID = 0;
+
+        // The first copy into a freshly imported destination has been observed not to land
+        // completely (scattered pixels keep their pre-copy contents) even though its fence
+        // signals; a second copy always fixes it. Repeat full copies until we trust the buffer.
+        int                                            fullCopiesLeft = 2;
+    };
+#endif
+
+    class CVulkanCopier {
+      public:
+        // Creates a copier on the Vulkan physical device that corresponds to drmFD. Returns null
+        // if Vulkan isn't available, the device can't be matched, or a required extension is
+        // missing. Never throws.
+        static Hyprutils::Memory::CSharedPointer<CVulkanCopier> attempt(Hyprutils::Memory::CSharedPointer<CBackend> backend, int drmFD);
+        ~CVulkanCopier();
+
+        // DRM modifiers this device can import via dma-buf for the given fourcc as a copy
+        // source (asSource) or destination.
+        std::vector<uint64_t> importableModifiers(uint32_t fourcc, bool asSource);
+
+        // Can `from` be copied into `to` on this device? Checks formats, sizes, planes, modifiers.
+        bool canCopy(Hyprutils::Memory::CSharedPointer<IBuffer> from, Hyprutils::Memory::CSharedPointer<IBuffer> to);
+
+        struct SResult {
+            bool success = false;
+            // sync_file that signals when the copy is done. Owned by the copier, valid until the
+            // copier is destroyed or a few more copies have been issued. Dup it if you need to keep it.
+            int syncFD = -1;
+        };
+
+        // Copy `from` into `to`, waiting for `waitFD` (a sync_file, may be -1) on the GPU first.
+        // `damage` (in destination pixel coordinates) is what changed in `from` since the previous
+        // frame; the copier tracks per-destination staleness and copies only what that buffer
+        // needs. Pass nullptr when the damage isn't known: that forces a full copy.
+        SResult                                        copy(Hyprutils::Memory::CSharedPointer<IBuffer> from, Hyprutils::Memory::CSharedPointer<IBuffer> to, int waitFD,
+                                                            const Hyprutils::Math::CRegion* damage = nullptr);
+
+        bool                                           healthy() const;
+
+        Hyprutils::Memory::CWeakPointer<CVulkanCopier> self;
+        std::string                                    deviceName;
+
+#ifdef AQUAMARINE_HAS_VULKAN
+      private:
+        CVulkanCopier() = default;
+
+        bool                                     init(int drmFD);
+        bool                                     loadLoader();
+        bool                                     pickPhysicalDevice(int drmFD);
+        bool                                     createDevice();
+        bool                                     createSlots();
+        void                                     destroySlots();
+
+        Hyprutils::Memory::CSharedPointer<CVulkanImageAttachment> importBuffer(Hyprutils::Memory::CSharedPointer<IBuffer> buf, bool asSource);
+        void                                     destroyImage(VkImage image, VkDeviceMemory memory);
+        std::optional<VkFormat>                  vkFormat(uint32_t fourcc);
+        bool                                     modifierImportable(VkFormat format, uint64_t modifier, VkImageUsageFlags usage);
+
+        void                                     log(eBackendLogLevel level, const std::string& msg);
+
+        Hyprutils::Memory::CWeakPointer<CBackend> backend;
+
+        void*                                    loaderHandle = nullptr;
+        VkInstance                               instance     = VK_NULL_HANDLE;
+        VkPhysicalDevice                         physical     = VK_NULL_HANDLE;
+        VkDevice                                 device       = VK_NULL_HANDLE;
+        VkQueue                                  queue        = VK_NULL_HANDLE;
+        uint32_t                                 queueFamily  = UINT32_MAX;
+        VkCommandPool                            commandPool  = VK_NULL_HANDLE;
+        VkPhysicalDeviceMemoryProperties         memoryProps{};
+
+        struct SSlot {
+            VkCommandBuffer cmd       = VK_NULL_HANDLE;
+            VkFence         fence     = VK_NULL_HANDLE;
+            VkSemaphore     signalSem = VK_NULL_HANDLE; // exportable as sync_file
+            VkSemaphore     waitSem   = VK_NULL_HANDLE; // gets a temporary sync_file import
+            int             lastFD    = -1;
+            bool            pending   = false;
+            uint64_t        copyID    = 0; // which copy this slot is currently running
+        };
+        static constexpr size_t SLOTS = 4;
+        std::vector<SSlot>      slots;
+        size_t                  nextSlot        = 0;
+        int                     failures        = 0;
+        bool                    broken          = false;
+        bool                    fenceProven     = false; // a copy fence was observed to signal in this process
+        bool                    debug           = false; // AQ_MGPU_VK_DEBUG: mirror logs to stderr (journal)
+        uint64_t                copies          = 0;
+
+        // waits (bounded) for every pending slot; returns false if something never finished
+        bool                    drainPending(uint64_t timeoutNs);
+
+        // every live destination import, for propagating each frame's damage to the buffers that
+        // are not being written this frame. Pruned lazily.
+        std::vector<Hyprutils::Memory::CWeakPointer<CVulkanImageAttachment>> destinations;
+
+        // A region with more rectangles than this is copied as its bounding box instead. The copy
+        // engine handles many small regions fine; the cap only exists so a pathological region
+        // can't turn one copy into thousands of tiny transfers.
+        static constexpr size_t MAX_COPY_RECTS = 64;
+
+        std::map<std::pair<uint32_t, bool>, std::vector<uint64_t>> modifierCache;
+
+        struct {
+            PFN_vkGetInstanceProcAddr                           vkGetInstanceProcAddr                           = nullptr;
+            PFN_vkCreateInstance                                vkCreateInstance                                = nullptr;
+            PFN_vkDestroyInstance                               vkDestroyInstance                               = nullptr;
+            PFN_vkEnumeratePhysicalDevices                      vkEnumeratePhysicalDevices                      = nullptr;
+            PFN_vkGetPhysicalDeviceProperties2                  vkGetPhysicalDeviceProperties2                  = nullptr;
+            PFN_vkGetPhysicalDeviceQueueFamilyProperties        vkGetPhysicalDeviceQueueFamilyProperties        = nullptr;
+            PFN_vkGetPhysicalDeviceMemoryProperties             vkGetPhysicalDeviceMemoryProperties             = nullptr;
+            PFN_vkEnumerateDeviceExtensionProperties            vkEnumerateDeviceExtensionProperties            = nullptr;
+            PFN_vkGetPhysicalDeviceFormatProperties2            vkGetPhysicalDeviceFormatProperties2            = nullptr;
+            PFN_vkGetPhysicalDeviceImageFormatProperties2       vkGetPhysicalDeviceImageFormatProperties2       = nullptr;
+            PFN_vkGetPhysicalDeviceExternalSemaphoreProperties  vkGetPhysicalDeviceExternalSemaphoreProperties  = nullptr;
+            PFN_vkCreateDevice                                  vkCreateDevice                                  = nullptr;
+            PFN_vkDestroyDevice                                 vkDestroyDevice                                 = nullptr;
+            PFN_vkGetDeviceProcAddr                             vkGetDeviceProcAddr                             = nullptr;
+            PFN_vkGetDeviceQueue                                vkGetDeviceQueue                                = nullptr;
+            PFN_vkDeviceWaitIdle                                vkDeviceWaitIdle                                = nullptr;
+            PFN_vkCreateCommandPool                             vkCreateCommandPool                             = nullptr;
+            PFN_vkDestroyCommandPool                            vkDestroyCommandPool                            = nullptr;
+            PFN_vkAllocateCommandBuffers                        vkAllocateCommandBuffers                        = nullptr;
+            PFN_vkResetCommandBuffer                            vkResetCommandBuffer                            = nullptr;
+            PFN_vkBeginCommandBuffer                            vkBeginCommandBuffer                            = nullptr;
+            PFN_vkEndCommandBuffer                              vkEndCommandBuffer                              = nullptr;
+            PFN_vkCmdPipelineBarrier                            vkCmdPipelineBarrier                            = nullptr;
+            PFN_vkCmdCopyImage                                  vkCmdCopyImage                                  = nullptr;
+            PFN_vkQueueSubmit                                   vkQueueSubmit                                   = nullptr;
+            PFN_vkCreateFence                                   vkCreateFence                                   = nullptr;
